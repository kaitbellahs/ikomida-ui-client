{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "isolatedModules": false,
    "noImplicitAny": true,
    "strict": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib",
    "allowSyntheticDefaultImports": true,
    "target": "ES2021"
  },
  "plugins": [
    {
      "name": "typescript-svelte-plugin"
    }
  ]
}