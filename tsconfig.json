{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "include": [
    "src/**/*.ts",
  ],
  "exclude": [
    "node_modules/*",
    "**/*.spec.ts",
    "__sapper__/*",
    "public/*",
    "App/*"
  ],
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "isolatedModules": false,
    "noImplicitAny": true,
    "strict": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib",
    "target": "ESNext",
  }
}