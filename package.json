{
  "name": "svelte-app",
  "version": "1.0.0",
  "private": true,
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "sirv public --no-clear",
    "build:android": "run-s build:app cap-run:android",
    "build:ios": "run-s build:app cap-run:ios",
    "cap-run:android": "cap sync android && cap open android",
    "cap-run:ios": "cap sync ios && cap run ios",
    "dev:ios": "run-p build cap-run:ios",
    "dev:android": "run-p dev:start cap-run:android"
  },
  "devDependencies": {
    "@capacitor/cli": "^3.4.1",
    "@rollup/plugin-commonjs": "^21.0.1",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@roxi/routify": "^2.18.4",
    "node-sass": "^7.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.6",
    "postcss-load-config": "^3.1.3",
    "rollup": "^2.67.2",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-svelte": "^7.1.0",
    "rollup-plugin-terser": "^7.0.2",
    "svelte": "^3.46.4",
    "svelte-as-markup-preprocessor": "^0.2.0",
    "svelte-fa": "^2.4.0",
    "svelte-preprocess": "^4.10.3",
    "svelte-preprocess-cssmodules": "^2.1.2"
  },
  "dependencies": {
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^3.4.1",
    "@capacitor/app": "^1.1.0",
    "@capacitor/core": "^3.4.1",
    "@capacitor/geolocation": "^1.3.1",
    "@capacitor/ios": "^3.4.1",
    "@capacitor/network": "^1.0.7",
    "@capacitor/status-bar": "file:../../capacitor-plugins/status-bar",
    "@capacitor/storage": "^1.2.4",
    "@fortawesome/free-solid-svg-icons": "^6.0.0",
    "@tian/components": "file:../projx-components",
    "sirv-cli": "^2.0.2",
    "uuid": "^8.3.2"
  }
}
