{
  "name": "ikomida-client",
  "version": "${{version}}$",
  "private": true,
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "watch:prod": "rollup -c -w --environment ENV:production",
    "watch:hmlg": "rollup -c -w --environment ENV:homologation",
    "watch:dev": "rollup -c -w --environment ENV:development",
    "prod": "rollup -c --environment ENV:production",
    "hmlg": "rollup -c --environment ENV:homologation",
    "dev": "rollup -c --environment ENV:development",
    "start": "sirv App --no-clear",
    "windows": "@powershell -NoProfile -ExecutionPolicy Unrestricted -Command ./build.ps1",
    "build:win:dev": "yarn dev && yarn windows",
    "build:win:hmlg": "yarn hmlg && yarn windows",
    "build:win:prod": "yarn prod && yarn windows",
    "build:unix:dev": "yarn dev && ./build.sh",
    "build:unix:hmlg": "yarn hmlg && ./build.sh",
    "build:unix:prod": "yarn prod && ./build.sh",
    "build:android": "run-s build cap-run:android",
    "build:ios": "run-s build:app cap-run:ios",
    "cap-run:android": "cap sync android && cap open android",
    "cap-run:ios": "cap sync ios && cap run ios",
    "dev:ios": "run-p build cap-run:ios",
    "dev:android": "run-p dev:start cap-run:android",
    "prebuild:types": "rimraf ./build",
    "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts --quiet --fix",
    "clean": "rimraf ./build ./lib ./docs",
    "glogin": "artifactregistry-auth",
    "prepublishOnly": "yarn lint",
    "preversion": "yarn lint",
    "version": "yarn format && git add -A src",
    "postversion": "git push && git push --tags",
    "test": "mocha",
    "local:dev": "yarn glogin && ncu -u && yarn && yarn format && yarn lint && yarn svelte-check && yarn dev",
    "local:watch:dev": "yarn glogin && ncu -u && yarn && yarn format && yarn lint && yarn svelte-check && yarn watch:dev",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@capacitor/cli": "^4.6.1",
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-replace": "^5.0.2",
    "@rollup/plugin-typescript": "^10.0.1",
    "@tsconfig/svelte": "^3.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.6.0",
    "google-artifactregistry-auth": "^3.0.2",
    "javascript-obfuscator": "^4.0.0",
    "jsdoc": "^4.0.0",
    "linkify-it": "^4.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.20",
    "postcss-load-config": "^4.0.1",
    "prettier": "^2.8.1",
    "rimraf": "^3.0.2",
    "rollup": "^3.9.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svelte": "^7.1.0",
    "rollup-plugin-terser": "^7.0.2",
    "sirv-cli": "^2.0.2",
    "svelte": "^3.55.0",
    "svelte-as-markup-preprocessor": "^0.3.0",
    "svelte-check": "^3.0.1",
    "svelte-fa": "^3.0.3",
    "svelte-preprocess": "^5.0.0",
    "svelte-preprocess-cssmodules": "^2.2.3",
    "tslib": "^2.4.1",
    "typedoc": "^0.23.23",
    "typescript": "^4.9.4",
    "typescript-svelte-plugin": "^0.3.13"
  },
  "dependencies": {
    "@capacitor-community/date-picker": "^0.2.3",
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^4.6.1",
    "@capacitor/app": "^4.1.1",
    "@capacitor/app-launcher": "^4.1.0",
    "@capacitor/clipboard": "^4.1.0",
    "@capacitor/core": "^4.6.1",
    "@capacitor/device": "^4.1.0",
    "@capacitor/filesystem": "^4.1.4",
    "@capacitor/geolocation": "^4.1.0",
    "@capacitor/ios": "^4.6.1",
    "@capacitor/network": "^4.1.0",
    "@capacitor/preferences": "^4.0.2",
    "@capacitor/push-notifications": "^4.1.2",
    "@capacitor/share": "^4.1.0",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@ikomida/capacitor-plugin-status-bar": "github:TIAltoNivel/capacitor-plugin-statusbar",
    "@ikomida/shared-frontend": "^1.9.5",
    "@ikomida/shared-logics": "^1.3.1",
    "@ikomida/shared-types": "^1.9.7",
    "credit-card-type": "^9.1.0",
    "html2canvas": "^1.4.1",
    "uuid": "^9.0.0"
  }
}