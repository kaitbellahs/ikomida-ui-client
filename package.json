{
  "name": "ikomida-client",
  "version": "1.0.0",
  "private": true,
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "scripts": {
    "build:windows": "yarn install && rollup -c --environment ENV:prod && @powershell -NoProfile -ExecutionPolicy Unrestricted -Command ./build.ps1",
    "build:unix": "yarn install && rollup -c --environment ENV:prod && ./build.sh",
    "dev": "rollup -c -w",
    "prod": "rollup -c -w --environment ENV:prod",
    "start": "sirv public --no-clear",
    "build:android": "run-s build:app cap-run:android",
    "build:ios": "run-s build:app cap-run:ios",
    "cap-run:android": "cap sync android && cap open android",
    "cap-run:ios": "cap sync ios && cap run ios",
    "dev:ios": "run-p build cap-run:ios",
    "dev:android": "run-p dev:start cap-run:android"
  },
  "devDependencies": {
    "@capacitor/cli": "^4.0.0",
    "@rollup/plugin-commonjs": "^22.0.1",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@rollup/plugin-replace": "^4.0.0",
    "javascript-obfuscator": "^4.0.0",
    "node-sass": "^7.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.6",
    "postcss-load-config": "^4.0.1",
    "rollup": "^2.76.0",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-svelte": "^7.1.0",
    "rollup-plugin-terser": "^7.0.2",
    "svelte": "^3.49.0",
    "svelte-as-markup-preprocessor": "^0.3.0",
    "svelte-fa": "^3.0.3",
    "svelte-preprocess": "^4.10.3",
    "svelte-preprocess-cssmodules": "^2.1.2"
  },
  "dependencies": {
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^4.0.0",
    "@capacitor/app": "^4.0.0",
    "@capacitor/app-launcher": "^4.0.0",
    "@capacitor/clipboard": "^4.0.0",
    "@capacitor/core": "^4.0.0",
    "@capacitor/filesystem": "^4.0.1",
    "@capacitor/geolocation": "^4.0.0",
    "@capacitor/ios": "^4.0.0",
    "@capacitor/network": "^4.0.0",
    "@capacitor/preferences": "^4.0.1",
    "@capacitor/push-notifications": "^4.0.0",
    "@capacitor/share": "^4.0.1",
    "@fortawesome/free-solid-svg-icons": "^6.0.0",
    "@ikomida/capacitor-plugin-status-bar": "github:TIAltoNivel/capacitor-plugin-statusbar",
    "@ikomida/components": "github:TIAltoNivel/ikomida-components",
    "credit-card-type": "^9.1.0",
    "html2canvas": "^1.4.1",
    "sirv-cli": "^2.0.2",
    "uuid": "^8.3.2"
  }
}
