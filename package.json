{
  "name": "ikomida-client",
  "version": "0.0.1",
  "private": true,
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "scripts": {
    "build:windows": "yarn upgrade && rollup -c --environment ENV:prod && @powershell -NoProfile -ExecutionPolicy Unrestricted -Command ./build.ps1",
    "build:mac": "rollup -c --environment ENV:prod && yarn cap copy",
    "build:mac:release": "yarn upgrade && rollup -c --environment ENV:prod && ./build.sh",
    "build": "rollup -c --environment ENV:prod",
    "dev": "rollup -c -w",
    "prod": "rollup -c -w --environment ENV:prod",
    "start": "sirv App --no-clear",
    "build:android": "run-s build cap-run:android",
    "build:ios": "run-s build:app cap-run:ios",
    "cap-run:android": "cap sync android && cap open android",
    "cap-run:ios": "cap sync ios && cap run ios",
    "dev:ios": "run-p build cap-run:ios",
    "dev:android": "run-p dev:start cap-run:android",
    "prebuild:types": "rimraf ./build",
    "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts --quiet --fix",
    "clean": "rimraf ./build ./lib ./docs",
    "glogin": "artifactregistry-auth",
    "prepare": "yarn build",
    "prepublishOnly": "yarn lint",
    "preversion": "yarn lint",
    "version": "yarn format && git add -A src",
    "postversion": "git push && git push --tags",
    "test": "mocha",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@capacitor/cli": "^4.2.0",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@rollup/plugin-replace": "^4.0.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@tsconfig/svelte": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^5.38.0",
    "@typescript-eslint/parser": "^5.38.0",
    "chai": "^4.3.6",
    "eslint": "^8.23.1",
    "eslint-config-prettier": "^8.5.0",
    "google-artifactregistry-auth": "^3.0.2",
    "javascript-obfuscator": "^4.0.0",
    "jsdoc": "^3.6.11",
    "linkify-it": "^4.0.1",
    "mocha": "^10.0.0",
    "node-sass": "^7.0.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.16",
    "postcss-load-config": "^4.0.1",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.79.0",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-svelte": "^7.1.0",
    "rollup-plugin-terser": "^7.0.2",
    "sirv-cli": "^2.0.2",
    "svelte": "^3.50.1",
    "svelte-as-markup-preprocessor": "^0.3.0",
    "svelte-check": "^2.9.0",
    "svelte-fa": "^3.0.3",
    "svelte-preprocess": "^4.10.7",
    "svelte-preprocess-cssmodules": "^2.2.3",
    "tslib": "^2.4.0",
    "typedoc": "^0.23.15",
    "typescript": "^4.8.3"
  },
  "dependencies": {
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^4.2.0",
    "@capacitor/app": "^4.0.1",
    "@capacitor/app-launcher": "^4.0.1",
    "@capacitor/clipboard": "^4.0.1",
    "@capacitor/core": "^4.2.0",
    "@capacitor/device": "^4.0.1",
    "@capacitor/filesystem": "^4.1.1",
    "@capacitor/geolocation": "^4.0.1",
    "@capacitor/ios": "^4.2.0",
    "@capacitor/network": "^4.0.1",
    "@capacitor/preferences": "^4.0.1",
    "@capacitor/push-notifications": "^4.1.0",
    "@capacitor/share": "^4.0.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@ikomida/capacitor-plugin-status-bar": "github:TIAltoNivel/capacitor-plugin-statusbar",
    "@ikomida/shared-frontend": "^0.0.84",
    "credit-card-type": "^9.1.0",
    "html2canvas": "^1.4.1",
    "uuid": "^9.0.0"
  }
}
